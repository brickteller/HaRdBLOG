---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Calendar | HaRdLUG"
  description="Upcoming HaRdLUG events."
>
<Header activeNav="calendar" />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 py-8">
    <article class="prose">
      <h1>HaRdLUG Calendar</h1>

      <p>
        Upcoming HaRdLUG events are created and managed through our Discord server.
      </p>
    </article>

    <div class="calendar-wrapper">
      <iframe
        title="HaRdLUG Events Calendar"
        src="https://calendar.google.com/calendar/embed?src=hardlug2002%40gmail.com&ctz=America%2FNorfolk" 
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

<div class="calendar-wrapper calendar-desktop">
  <iframe
    title="HaRdLUG Events Calendar"
        src="https://calendar.google.com/calendar/embed?src=hardlug2002%40gmail.com&ctz=America%2FNorfolk" 
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

<div class="calendar-wrapper calendar-mobile">
  <iframe
    title="HaRdLUG Events Agenda"
        src="https://calendar.google.com/calendar/embed?src=hardlug2002%40gmail.com&ctz=America%2FNorfolk&mode=AGENDA"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

  </main>

  <Footer />
</Layout>

<style>
  .calendar-wrapper {
    @apply mt-6 overflow-hidden rounded border border-skin-line bg-skin-card;
  }

  .calendar-wrapper iframe {
    @apply block w-full border-0;
    min-height: 700px;
  }
</style>

.calendar-mobile {
  display: none;
}

@media (max-width: 639px) {
  .calendar-desktop {
    display: none;
  }

  .calendar-mobile {
    display: block;
  }

  .calendar-wrapper iframe {
    min-height: 600px;
  }
}
